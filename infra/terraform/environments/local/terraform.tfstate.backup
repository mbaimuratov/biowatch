          "schema_version": 0,
          "attributes": {
            "content": "global:\n  scrape_interval: 15s\n\nalerting:\n  alertmanagers:\n    - static_configs:\n        - targets:\n            - \"biowatch-tf-alertmanager:9093\"\n\nrule_files:\n  - /etc/prometheus/alerts.yml\n\nscrape_configs:\n  - job_name: \"prometheus\"\n    static_configs:\n      - targets: [\"localhost:9090\"]\n",
