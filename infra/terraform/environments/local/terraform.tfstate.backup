    {
      "mode": "managed",
      "type": "local_file",
      "name": "prometheus_alerts",
      "provider": "provider[\"registry.terraform.io/hashicorp/local\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "content": "groups:\n  - name: local-test\n    rules:\n      - alert: PrometheusAlwaysFiring\n        expr: vector(1)\n        for: 30s\n        labels:\n          severity: warning\n        annotations:\n          summary: \"Test alert is firing\"\n          description: \"This alert always fires locally to verify Prometheus -\u003e Alertmanager wiring.\"\n",
            "content_base64": null,
            "content_base64sha256": "2KTuyd0wjMB88IA2JUsLdX/a9FrbJWNEaibtGlKU6K8=",
