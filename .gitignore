.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/

sealed-secrets-cert.pem
*.pem
/tmp/biowatch-secret.yaml

# Terraform local state
infra/terraform/**/.terraform/
infra/terraform/**/.terraform.tfstate.lock.info
infra/terraform/**/terraform.tfstate
infra/terraform/**/terraform.tfstate.*
infra/terraform/**/terraform.tfvars
infra/terraform/**/*.tfvars
infra/terraform/**/*.tfvars.json
infra/terraform/**/crash.log
infra/terraform/**/crash.*.log
infra/terraform/**/tfplan
infra/terraform/**/*.tfplan
infra/terraform/**/override.tf
infra/terraform/**/override.tf.json
infra/terraform/**/*_override.tf
infra/terraform/**/*_override.tf.json

# Keep provider lock files committed
!infra/terraform/**/.terraform.lock.hcl
